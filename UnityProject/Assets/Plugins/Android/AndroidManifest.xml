<?xml version="1.0" encoding="utf-8"?>
<!--
    MSG (Meridian Symptom Guide) AndroidManifest
    Unity 6 (6000.x) / GameActivity 기반

    주의: android:theme 속성을 명시하지 않음.
    Unity 빌드 파이프라인이 자동으로 UnityThemeSelector(AppCompat 계열)를 주입함.
    커스텀 manifest에서 theme를 지정하면 Unity의 styles.xml 없이 참조되어
    IllegalStateException: Theme.AppCompat 크래시 발생.

    주의: @string/app_name, @mipmap/app_icon 등 Android res 참조 사용 금지.
    Unity 6에서는 Assets/Plugins/Android/res 폴더가 폐기되어
    리소스 참조 시 런타임 크래시 발생. 리터럴 값 또는 Unity Player Settings 값 사용.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.thejmh.MSG">

    <!-- 카메라 권한 (AR 필수) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ARCore 선택적 지원: 미지원 기기에서도 설치/실행 허용 -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <!-- ARCore 선택적 선언 -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <activity
            android:name="com.unity3d.player.UnityPlayerGameActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="portrait"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:hardwareAccelerated="true"
            android:exported="true"
            android:launchMode="singleTask">

            <!-- 앱 런처 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 딥링크: msg-app://treat?p=[Base64Payload] -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="msg-app"
                    android:host="treat" />
            </intent-filter>

        </activity>
    </application>

</manifest>
